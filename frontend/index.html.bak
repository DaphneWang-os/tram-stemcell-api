      {label: "患者交互方式", status: /移植|注射|输注|回输/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "研究阶段", status: /I期|II期|III期|Phase/.test(text) ? "符合" : "部分符合", detail: ""},
      {label: "细胞操作流程逐项披露", status: ["分离","采集","扩增","培养","基因编辑","分化","冻存","复苏","质控","回输","移植"].filter(function(k){return text.indexOf(k)>=0;}).length >= 3 ? "符合" : "部分符合", detail: ""},
      {label: "供者与受试者角色区分", status: /供者|donor|采集|回输/.test(text) ? "部分符合" : "不符合", detail: ""},
      {label: "研究性质明示", status: /研究|试验/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "细胞最终用途限定", status: /未来研究|商业转化|future research/.test(text) ? "部分符合" : "不符合", detail: ""},
      {label: "体外操作时间/培养代数", status: /培养.{0,6}\d+|传代|代数|P\d/.test(text) ? "部分符合" : "不符合", detail: "", trigger: "E"},
      {label: "冷冻保存及解冻告知", status: /冻存|冷冻|解冻|DMSO|cryopreserv/.test(text) ? "符合" : "不符合", detail: "", trigger: "C"},
      {label: "培养代数及传代次数", status: /代数|传代|passage/.test(text) ? "部分符合" : "不符合", detail: "", trigger: "E"},
      {label: "剂量递增/MTD", status: /剂量递增|MTD|剂量组|爬坡|DLT/.test(text) ? "符合" : "不符合", detail: "", trigger: "D"}
    ]
  });

  dims.push({
    name: "维度二：风险获益沟通", icon: "⚠️", tram: "R",
    items: [
      {label: "临床风险（致瘤性/排斥/GVHD）", status: /致瘤|免疫排斥|GVHD|移植物抗宿主/.test(text) ? "符合" : "部分符合", detail: ""},
      {label: "隐私与伦理", status: /隐私|保密|伦理/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "长期风险", status: /长期风险|远期|延迟|继发/.test(text) ? "部分符合" : "不符合", detail: ""},
      {label: "获益披露", status: /获益|受益|改善/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "不确定性", status: /未知|不确定|不能保证|尚不清楚/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "治疗性误解防范", status: /不是治疗|不等于治疗|非治疗性/.test(text) ? "符合" : "部分符合", detail: ""},
      {label: "替代方案具体列举", status: /替代方案|其他治疗|常规治疗|手术|化疗/.test(text) ? "符合" : "部分符合", detail: ""},
      {label: "风险发生率告知", status: /\d+\s*%|发生率|常见|罕见/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "研究不等于治疗警示框", status: /研究不是治疗|不等于治疗|重要提示/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "无疗效可能性告知", status: /可能无效|可能无获益|未必有效/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "免疫抑制方案", status: /他克莫司|环孢素|甲氨蝶呤|霉酚酸酯|激素|tacrolimus/.test(text) ? "符合" : "不符合", detail: "", trigger: "I"},
      {label: "长期随访", status: /随访.{0,6}\d+\s*年|\d+\s*年.{0,6}随访|长期随访/.test(text) ? "符合" : "不符合", detail: "", trigger: "L"},
      {label: "解冻后功能衰减", status: /解冻后.{0,6}活性|解冻后.{0,6}功能|复苏后/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "过度传代致效力降低", status: /过度传代|复制性衰老|效力降低/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "DLT及停药规则", status: /DLT|剂量限制性|停药规则/.test(text) ? "符合" : "不符合", detail: "", trigger: "D"}
    ]
  });

  dims.push({
    name: "维度三：可读性与可访问性", icon: "📖", tram: null,
    items: [
      {label: "文档长度≤15,000字符", status: totalChar <= 15000 ? "符合" : (totalChar <= 30000 ? "部分符合" : "不符合"), detail: totalChar + " 字符"},
      {label: "SMOG可读性", status: "部分符合", detail: "（简化估算）"},
      {label: "视觉辅助", status: /流程图|示意图|机制图|Figure/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "分层结构", status: /摘要|概述|目录|章节/.test(text) ? "符合" : "部分符合", detail: ""},
      {label: "交互数字同意", status: /电子知情|电子签名|视频知情|eConsent/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "阅读水平匹配", status: /通俗|易懂|简明/.test(text) ? "符合" : "部分符合", detail: ""},
      {label: "多语言适配", status: /多语言|翻译|双语|中英对照/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "风险摘要突出显示", status: /风险摘要|重要风险|加粗|置顶/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "版本号与修订日期", status: /版本|version|V\d+\.\d|修订/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "视频辅助解释流程", status: /视频讲解|视频演示|动画演示|二维码/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "关键术语词汇表", status: /词汇表|术语表|名词解释|glossary/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "风险/获益对比图", status: /风险.{0,6}获益.{0,6}对比|获益对比图/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "解冻-回输时间窗口图", status: /解冻.{0,6}回输.{0,6}时间|时间窗口/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "培养代数趋势图", status: /代数.{0,6}状态|趋势图/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "剂量-毒性可视化图", status: /剂量.{0,6}毒性.{0,6}关系|剂量-?毒性/.test(text) ? "符合" : "不符合", detail: ""}
    ]
  });

  dims.push({
