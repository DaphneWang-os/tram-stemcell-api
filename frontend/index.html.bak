","trigger":null},{"label":"伦理审查","status":"信息","detail":"","trigger":null},{"label":"退出权保障","status":"信息","detail":"","trigger":null},{"label":"研究变更时重新同意","status":"信息","detail":"","trigger":null},{"label":"撤回同意即时生效","status":"信息","detail":"","trigger":null},{"label":"不良反应实时告知","status":"信息","detail":"","trigger":null},{"label":"年度随访知情重申","status":"信息","detail":"","trigger":null},{"label":"儿童年龄过渡期重新知情","status":"信息","detail":"","trigger":null},{"label":"解冻后效期变更告知","status":"信息","detail":"","trigger":null},{"label":"传代接近上限提前告知","status":"信息","detail":"","trigger":null},{"label":"剂量组DLT实时告知","status":"信息","detail":"","trigger":null}],"stat":{"符合":0,"部分符合":0,"不符合":0,"不适用":0,"未知":0}}]},{"nct":"N/A（非ClinicalTrials.gov注册）","title":"人脐带间充质干细胞治疗放射相关性肺损伤的安全性和有效性临床研究","dims":[{"name":"维度一：技术披露","icon":"🔬","tram":null,"items":[{"label":"干细胞类型","status":"信息","detail":"","trigger":null},{"label":"细胞来源","status":"信息","detail":"","trigger":"A"},{"label":"处理方式","status":"信息","detail":"","trigger":null},{"label":"自主程度","status":"信息","detail":"","trigger":null},{"label":"偏离标准治疗","status":"信息","detail":"","trigger":null},{"label":"患者交互方式","status":"信息","detail":"","trigger":null},{"label":"研究阶段","status":"信息","detail":"","trigger":null},{"label":"细胞操作流程逐项披露","status":"信息","detail":"","trigger":null},{"label":"供者与受试者角色区分","status":"信息","detail":"","trigger":null},{"label":"研究性质明示","status":"信息","detail":"","trigger":null},{"label":"细胞最终用途限定","status":"信息","detail":"","trigger":null},{"label":"体外操作时间/代数","status":"信息","detail":"","trigger":"E"},{"label":"冷冻保存及解冻","status":"信息","detail":"","trigger":"C"},{"label":"培养代数及传代","status":"信息","detail":"","trigger":"E"},{"label":"剂量递增/MTD","status":"信息","detail":"","trigger":"D"}],"stat":{"符合":0,"部分符合":0,"不符合":0,"不适用":0,"未知":0}},{"name":"维度二：风险获益沟通","icon":"⚠️","tram":"R","items":[{"label":"临床风险","status":"信息","detail":"","trigger":null},{"label":"隐私与伦理","status":"信息","detail":"","trigger":null},{"label":"长期风险","status":"信息","detail":"","trigg