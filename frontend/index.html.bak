<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TRAM 干细胞 ICF 评估系统</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif;
    background:linear-gradient(160deg,#eef2ff 0%,#f8fafc 45%,#ecfeff 100%);
    min-height:100vh;color:#1e293b;padding:26px 16px 70px;}
  .wrap{max-width:1180px;margin:0 auto}
  header{text-align:center;margin-bottom:22px}
  h1{font-size:26px;font-weight:800;color:#0f172a}
  h1 span{background:linear-gradient(90deg,#4f46e5,#0891b2);-webkit-background-clip:text;color:transparent}
  .sub{margin-top:6px;font-size:13px;color:#64748b}
  .tabs{display:flex;justify-content:center;gap:10px;margin-bottom:22px;flex-wrap:wrap}
  .tab{border:none;cursor:pointer;font-family:inherit;padding:11px 22px;font-size:14px;font-weight:700;
    background:#fff;color:#475569;border-radius:12px;box-shadow:0 3px 12px rgba(15,23,42,.07);transition:.2s}
  .tab.active{background:linear-gradient(135deg,#6366f1,#0891b2);color:#fff;box-shadow:0 8px 22px rgba(99,102,241,.32)}
  .panel{display:none}.panel.active{display:block}
  .searchbox{position:relative;max-width:760px;margin:0 auto 8px}
  .searchbox input{width:100%;padding:16px 52px 16px 20px;font-size:15px;
    border:2px solid #e2e8f0;border-radius:16px;outline:none;background:#fff;font-family:inherit}
  .searchbox input:focus{border-color:#6366f1}
  .searchbox .ico{position:absolute;right:18px;top:50%;transform:translateY(-50%);font-size:18px;color:#94a3b8}
  #suggest{max-width:760px;margin:0 auto;background:#fff;border-radius:14px;box-shadow:0 12px 30px rgba(15,23,42,.13);overflow:hidden}
  #suggest:empty{display:none}
  .sug{padding:11px 18px;cursor:pointer;border-bottom:1px solid #f1f5f9;font-size:13px;line-height:1.5}
  .sug:hover{background:#eef2ff}
  .sug b{color:#4f46e5}
  .analyze-box{max-width:980px;margin:0 auto}
  textarea{width:100%;min-height:240px;padding:16px 18px;font-size:13px;font-family:Consolas,monospace;
    border:2px solid #e2e8f0;border-radius:14px;outline:none;background:#fff;resize:vertical;line-height:1.7}
  textarea:focus{border-color:#6366f1}
  .actions{display:flex;gap:12px;margin-top:14px;flex-wrap:wrap;align-items:center}
  .btn{border:none;cursor:pointer;font-family:inherit;padding:12px 30px;font-size:14px;font-weight:700;
    background:linear-gradient(135deg,#6366f1,#0891b2);color:#fff;border-radius:12px;box-shadow:0 8px 22px rgba(99,102,241,.32);transition:.2s}
  .btn:hover{transform:translateY(-1px)}
  .btn.ghost{background:#fff;color:#475569;box-shadow:0 3px 12px rgba(15,23,42,.09)}
  .btn.tram{background:linear-gradient(135deg,#8b5cf6,#ec4899);margin-top:12px;padding:10px 24px;font-size:13px}
  .btn.orch{background:linear-gradient(135deg,#0ea5e9,#22c55e);margin-top:12px;padding:10px 24px;font-size:13px;margin-left:8px}
  #hint{text-align:center;color:#94a3b8;font-size:13px;margin-top:36px;line-height:2}
  .study-card{background:#fff;border-radius:18px;padding:22px 26px;margin:26px auto 20px;
    box-shadow:0 10px 34px rgba(15,23,42,.10);border-left:5px solid #6366f1}
  .study-title{font-size:17px;font-weight:700;color:#0f172a;line-height:1.5}
  .study-meta{margin-top:12px;display:flex;flex-wrap:wrap;gap:8px}
  .tag{display:inline-block;padding:4px 12px;border-radius:20px;font-size:12px;background:#eef2ff;color:#4338ca;font-weight:600}
  .tag.g{background:#dcfce7;color:#15803d}
  .tag.o{background:#fef3c7;color:#b45309}
  .dim{background:#fff;border-radius:16px;margin-bottom:16px;overflow:hidden;box-shadow:0 4px 18px rgba(15,23,42,.07)}
  .dim-head{display:flex;align-items:center;gap:12px;padding:14px 22px;background:linear-gradient(90deg,#f8fafc,#f1f5f9);border-bottom:1px solid #e2e8f0;flex-wrap:wrap}
  .dim-head .t{font-size:15px;font-weight:700;color:#0f172a;flex:1;min-width:160px}
  .chip{font-size:11px;padding:3px 10px;border-radius:14px;font-weight:600}
  .chip.ok{background:#dcfce7;color:#15803d}
  .chip.part{background:#fef3c7;color:#b45309}
  .chip.no{background:#fee2e2;color:#b91c1c}
  .chip.na{background:#f1f5f9;color:#64748b}
  .chip.tram{background:#e0e7ff;color:#4338ca}
  .item{padding:12px 22px;border-bottom:1px solid #f8fafc}
  .item:last-child{border-bottom:none}
  .row{display:flex;align-items:flex-start;gap:10px}
  .dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto;margin-top:6px}
  .dot.ok{background:#22c55e}.dot.part{background:#f59e0b}.dot.no{background:#ef4444}
  .dot.na{background:#94a3b8}.dot.unk{background:#cbd5e1}.dot.info{background:#6366f1}
  .lbl{flex:1;font-size:13.5px;line-height:1.6;color:#334155}
  .badge{flex:0 0 auto;font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px;white-space:nowrap}
  .badge.ok{background:#dcfce7;color:#15803d}
  .badge.part{background:#fef3c7;color:#b45309}
  .badge.no{background:#fee2e2;color:#b91c1c}
  .badge.na{background:#f1f5f9;color:#64748b}
  .badge.unk{background:#f8fafc;color:#94a3b8}
  .badge.info{background:#e0e7ff;color:#4338ca}
  .det{font-size:12px;color:#64748b;line-height:1.7;margin-top:6px;padding:8px 12px;background:#f8fafc;border-radius:8px;border-left:3px solid #e2e8f0;word-break:break-all}
  .tram-panel{background:#fff;border-radius:18px;padding:24px 28px;margin-bottom:16px;
    box-shadow:0 10px 34px rgba(15,23,42,.10);border-left:5px solid #8b5cf6}
  .tram-panel h2{font-size:18px;color:#0f172a;margin-bottom:6px}
  .tram-panel .tram-sub{font-size:12px;color:#94a3b8;margin-bottom:20px}
  .tram-section{margin-bottom:24px}.tram-section:last-child{margin-bottom:0}
  .tram-section h3{font-size:14px;color:#334155;margin-bottom:12px;display:flex;align-items:center;gap:8px}
  .num-badge{background:#e0e7ff;color:#4338ca;font-size:11px;font-weight:800;padding:3px 9px;border-radius:6px}
  .triggers{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px}
  .trigger{flex:1;min-width:120px;background:#f8fafc;border-radius:10px;padding:12px 14px;border-left:3px solid #cbd5e1}
  .trigger.on{background:#eef2ff;border-left-color:#6366f1}
  .trigger .tcode{font-size:12px;font-weight:800;color:#6366f1;letter-spacing:.5px}
  .trigger .tname{font-size:12px;color:#475569;margin-top:3px}
  .trigger .tstate{font-size:11px;font-weight:700;margin-top:6px;padding:2px 8px;border-radius:5px;display:inline-block}
  .trigger.on .tstate{background:#c7d2fe;color:#3730a3}
  .trigger:not(.on) .tstate{background:#f1f5f9;color:#94a3b8}
  .tcs-display{display:flex;align-items:baseline;gap:12px;padding:16px 22px;
    background:linear-gradient(135deg,#eef2ff,#e0e7ff);border-radius:12px}
  .tcs-display .tcs-label{font-size:13px;color:#4338ca;font-weight:700}
  .tcs-display .tcs-num{font-size:32px;font-weight:800;color:#4338ca}
  .tcs-display .tcs-max{font-size:15px;color:#6366f1;font-weight:600}
  .score-bars{display:flex;flex-direction:column;gap:14px}
  .score-row{display:flex;flex-direction:column;gap:6px}
  .score-head{display:flex;justify-content:space-between;font-size:13px;color:#334155}
  .score-head .val{font-weight:800;color:#0f172a;font-size:15px}
  .score-bar{height:10px;background:#f1f5f9;border-radius:6px;overflow:hidden}
  .score-fill{height:100%;border-radius:6px;transition:.4s}
  .score-fill.r{background:linear-gradient(90deg,#22c55e,#16a34a)}
  .score-fill.o{background:linear-gradient(90deg,#f59e0b,#d97706)}
  .score-fill.g{background:linear-gradient(90deg,#6366f1,#4f46e5)}
  .score-fill.na{background:#cbd5e1}
  .profile-table{width:100%;border-collapse:collapse;font-size:13px}
  .profile-table th{text-align:left;padding:10px 12px;background:#f8fafc;color:#64748b;font-weight:700;font-size:12px;border-bottom:1px solid #e2e8f0}
  .profile-table td{padding:11px 12px;border-bottom:1px solid #f1f5f9;color:#334155}
  .profile-table .dir{font-weight:700;padding:3px 10px;border-radius:6px;font-size:11px;display:inline-block}
  .profile-table .dir.pos{background:#dcfce7;color:#15803d}
  .profile-table .dir.warn{background:#fef3c7;color:#b45309}
  .profile-table .dir.neg{background:#fee2e2;color:#b91c1c}
  .mismatch-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .mm-box{padding:20px 24px;border-radius:14px;background:linear-gradient(135deg,#f0f9ff,#e0f2fe);border-left:4px solid #0891b2}
  .mm-box.mismatch{background:linear-gradient(135deg,#fef2f2,#fee2e2);border-left-color:#ef4444}
  .mm-box .mm-label{font-size:12px;color:#475569;font-weight:700;margin-bottom:6px}
  .mm-box .mm-val{font-size:34px;font-weight:800;color:#0e7490}
  .mm-box.mismatch .mm-val{color:#b91c1c}
  .gap-group{margin-bottom:16px}
  .gap-head{display:flex;align-items:center;gap:10px;margin-bottom:8px;font-size:13px;font-weight:700;color:#334155}
  .tag-mini{font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:#fee2e2;color:#b91c1c}
  .tag-mini.ok{background:#dcfce7;color:#15803d}
  .gap-list{list-style:none;padding-left:0}
  .gap-list li{padding:8px 14px;background:#fff7f7;border-radius:8px;border-left:3px solid #fca5a5;margin-bottom:6px;font-size:12.5px;color:#475569}
  .gap-list li.partial{background:#fffbf0;border-left-color:#fcd34d}
  .gap-list li.empty{background:#f0fdf4;border-left-color:#86efac;color:#15803d}
  .disclaimer{margin-top:20px;padding:14px 18px;background:#fffbeb;border-left:4px solid #f59e0b;border-radius:10px;font-size:12.5px;color:#78350f;line-height:1.85}
  .disclaimer strong{color:#b45309}
  .cohort-panel{background:#fff;border-radius:18px;padding:24px 28px;box-shadow:0 10px 34px rgba(15,23,42,.10);border-left:5px solid #22c55e}
  .cohort-table{width:100%;border-collapse:collapse;font-size:13px;margin-top:14px}
  .cohort-table th{background:#f0fdf4;padding:10px 12px;text-align:left;color:#15803d;font-weight:700;font-size:12px;border-bottom:2px solid #86efac}
  .cohort-table td{padding:10px 12px;border-bottom:1px solid #f1f5f9;color:#334155}
  .cohort-ref{margin-top:18px;padding:14px 18px;background:#f0fdf4;border-radius:10px;font-size:12.5px;color:#166534;line-height:1.85}
  .status-msg{padding:12px 18px;border-radius:10px;font-size:13px;margin:10px 0}
  .status-msg.ok{background:#dcfce7;color:#15803d}
  .status-msg.err{background:#fee2e2;color:#b91c1c}
  .status-msg.info{background:#dbeafe;color:#1e40af}
  @media(max-width:640px){h1{font-size:19px}.study-card{padding:17px 18px}.item{padding:12px 15px}.mismatch-grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>🧬 干细胞 ICF <span>五维度评估 + TRAM 适配分析</span></h1>
    <div class="sub">查询内置 ICF · 分析新 ICF · TRAM 技术—风险适配诊断</div>
  </header>

  <div class="tabs">
    <button class="tab active" data-tab="search">🔍 查询已有 ICF</button>
    <button class="tab" data-tab="analyze">📝 分析新 ICF</button>
    <button class="tab" data-tab="tram">📊 TRAM 适配分析</button>
  </div>

  <div class="panel active" id="panel-search">
    <div class="searchbox">
      <input id="q" type="text" placeholder="输入研究标题关键词 或 NCT 编号..." autocomplete="off">
      <span class="ico">🔍</span>
    </div>
    <div id="suggest"></div>
    <div id="result"></div>
    <div id="hint">内置 <b id="total"></b> 项 ICF 记录<br>输入关键词实时筛选 · 点击结果查看评估 · 底部生成 TRAM 剖面</div>
  </div>

  <div class="panel" id="panel-analyze">
    <div class="analyze-box">
      <div class="disclaimer" style="margin-bottom:14px">
        📌 粘贴 ICF 全文，点击"开始分析"，系统按五维度逐项扫描关键词。
      </div>
      <textarea id="newICF" placeholder="粘贴 ICF 全文（中文或英文）..."></textarea>
      <div class="actions">
        <button class="btn" id="analyzeBtn">开始分析</button>
        <button class="btn ghost" id="clearBtn">清空</button>
        <span id="analyzeMeta" style="margin-left:auto;font-size:12px;color:#94a3b8"></span>
      </div>
      <div id="analyzeResult"></div>
    </div>
  </div>

  <div class="panel" id="panel-tram">
    <div id="tramContent">
      <div class="study-card" style="text-align:center;padding:60px 20px">
        <h2 style="font-size:19px;color:#0f172a;margin-bottom:14px">📊 TRAM 技术—风险适配诊断</h2>
        <p style="color:#64748b;font-size:13.5px;line-height:2;max-width:520px;margin:0 auto">
          请先在「查询已有 ICF」或「分析新 ICF」Tab 中选择一份 ICF，<br>
          点击卡片底部的 <b style="color:#8b5cf6">「生成 TRAM 适配剖面」</b> 按钮。<br>
          系统将调用后端 Python 模型计算 TCS、R/O/G 得分、覆盖率与缺口清单。
        </p>
      </div>
    </div>
  </div>
</div>

<script>
const DATA = [{"nct":"NCT02443077","title":"Ibrutinib Before and After Stem Cell Transplant in Treating Patients With Relapsed or Refractory Diffuse Large B-cell Lymphoma","dims":[{"name":"维度一：技术披露","icon":"🔬","tram":null,"items":[{"label":"干细胞类型","status":"信息","detail":"","trigger":null},{"label":"细胞来源","status":"信息","detail":"","trigger":"A"},{"label":"处理方式","status":"信息","detail":"","trigger":null},{"label":"自主程度","status":"信息","detail":"","trigger":null},{"label":"偏离标准治疗","status":"信息","detail":"","trigger":null},{"label":"患者交互方式","status":"信息","detail":"","trigger":null},{"label":"研究阶段","status":"信息","detail":"","trigger":null},{"label":"细胞操作流程逐项披露","status":"信息","detail":"","trigger":null},{"label":"供者与受试者角色区分","status":"信息","detail":"","trigger":null},{"label":"研究性质明示","status":"信息","detail":"","trigger":null},{"label":"细胞最终用途限定","status":"信息","detail":"","trigger":null},{"label":"体外操作时间/代数","status":"信息","detail":"","trigger":"E"},{"label":"冷冻保存及解冻","status":"信息","detail":"","trigger":"C"},{"label":"培养代数及传代","status":"信息","detail":"","trigger":"E"},{"label":"剂量递增/MTD","status":"信息","detail":"","trigger":"D"}],"stat":{"符合":0,"部分符合":0,"不符合":0,"不适用":0,"未知":0}},{"name":"维度二：风险获益沟通","icon":"⚠️","tram":"R","items":[{"label":"临床风险","status":"信息","detail":"","trigger":null},{"label":"隐私与伦理","status":"信息","detail":"","trigger":null},{"label":"长期风险","status":"信息","detail":"","trigger":null},{"label":"获益披露","status":"信息","detail":"","trigger":null},{"label":"不确定性","status":"信息","detail":"","trigger":null},{"label":"治疗性误解防范","status":"信息","detail":"","trigger":null},{"label":"替代方案","status":"信息","detail":"","trigger":null},{"label":"风险发生率","status":"信息","detail":"","trigger":null},{"label":"研究不等于治疗警示","status":"信息","detail":"","trigger":null},{"label":"无疗效可能性","status":"信息","detail":"","trigger":null},{"label":"免疫抑制方案","status":"信息","detail":"","trigger":"I"},{"label":"长期随访","status":"信息","detail":"","trigger":"L"},{"label":"解冻后功能衰减","status":"信息","detail":"","trigger":