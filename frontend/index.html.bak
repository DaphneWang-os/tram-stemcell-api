    items: [
      {label: "数据类型", status: /血液|骨髓|细胞|基因|影像|病史/.test(text) ? "符合" : "部分符合", detail: ""},
      {label: "存储方案", status: /样本库|数据库|液氮|低温|biobank/.test(text) ? "符合" : "部分符合", detail: ""},
      {label: "访问权限", status: /访问|查阅|查看|第三方/.test(text) ? "符合" : "部分符合", detail: ""},
      {label: "保留期限", status: /保留\s*\d+\s*年|保存\s*\d+\s*年|永久保存/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "未来使用", status: /未来研究|二次研究|商业应用/.test(text) ? "符合" : "不符合", detail: ""},
