      {label: "第三方共享再次同意", status: /再次同意|再次授权|重新同意|书面同意/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "数据保留年限", status: /数据.{0,6}保留\s*\d+\s*年|数据.{0,4}销毁/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "冻存细胞标识与追溯", status: /标识|编号|追溯|条码|编码/.test(text) ? "部分符合" : "不符合", detail: ""},
      {label: "各代次质控数据记录", status: /质控|QC|放行|质检|无菌检测/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "不良事件与剂量关联", status: /不良事件.{0,6}剂量|剂量.{0,6}不良事件|因果关联/.test(text) ? "符合" : "不符合", detail: ""}
    ]
  });

  dims.push({
    name: "维度五：动态知情同意", icon: "🔄", tram: "O",
    items: [
      {label: "持续更新", status: /新信息|新发现|及时通知|技术变更/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "咨询渠道", status: /联系电话|咨询电话|伦理委员会.{0,6}电话|联系人/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "人员培训", status: /培训|资质|经验丰富|专业人员/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "退出管理", status: /退出后.{0,6}处理|撤回.{0,6}方案|退出.{0,4}方案/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "脆弱人群", status: /儿童|孕妇|老年|特殊人群|脆弱/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "伦理审查", status: /伦理委员会|IRB|伦理审查|伦理批准/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "退出权保障", status: /随时退出|不影响.{0,6}权益|自愿参加|无惩罚/.test(text) ? "符合" : "部分符合", detail: ""},
      {label: "研究变更时重新同意", status: /重新签署|再次签署|重新知情|重新同意/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "撤回同意即时生效", status: /撤回.{0,6}即时|立即销毁|即时生效/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "不良反应实时告知", status: /及时告知|实时告知|新信息.{0,6}告知/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "年度随访知情重申", status: /年度.{0,6}重申|每年.{0,6}知情|定期.{0,6}再确认/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "儿童年龄过渡期重新知情", status: /成年.{0,6}重新|年龄.{0,6}过渡|18岁/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "解冻后效期变更告知", status: /效期.{0,6}变更|有效期.{0,6}变更/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "传代接近上限提前告知", status: /传代.{0,6}上限|接近上限|代数.{0,6}接近/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "剂量组DLT实时告知", status: /DLT.{0,6}告知|全体受试者|其他受试者.{0,6}告知/.test(text) ? "符合" : "不符合", detail: ""}
    ]
  });

  dims.forEach(function(d){
    d.stat = {"符合":0,"部分符合":0,"不符合":0,"不适用":0,"未知":0};
    d.items.forEach(function(it){ if(d.stat[it.status] !== undefined) d.stat[it.status]++; });
  });

  const rec = {nct: "自定义文本（" + totalChar + " 字符）", title: "📝 新 ICF 分析结果", dims: dims};

  anaRes.innerHTML = "";
  const holder = document.createElement("div");
  anaRes.appendChild(holder);
  renderStudy(rec, holder, true);

  const totalOK = dims.reduce(function(s,d){return s+d.stat["符合"];},0);
  const totalPart = dims.reduce(function(s,d){return s+d.stat["部分符合"];},0);
  const totalNO = dims.reduce(function(s,d){return s+d.stat["不符合"];},0);
  anaMeta.textContent = "完成：" + totalOK + " 符合 · " + totalPart + " 部分 · " + totalNO + " 不符合";
});

clrBtn.addEventListener("click", function(){
  ta.value = "";
  anaRes.innerHTML = "";
  anaMeta.textContent = "";
  ta.focus();
});

checkServer();
</script>
</body>
</html>
