{"label":"保留期限","status":"信息","detail":"","trigger":null},{"label":"未来使用","status":"信息","detail":"","trigger":null},{"label":"法规引用","status":"信息","detail":"","trigger":null},{"label":"退出后选择","status":"信息","detail":"","trigger":null},{"label":"剩余样本处置","status":"信息","detail":"","trigger":null},{"label":"样本转运目的地","status":"信息","detail":"","trigger":null},{"label":"样本库存储条件","status":"信息","detail":"","trigger":null},{"label":"第三方共享再次同意","status":"信息","detail":"","trigger":null},{"label":"数据保留年限","status":"信息","detail":"","trigger":null},{"label":"冻存细胞标识","status":"信息","detail":"","trigger":null},{"label":"各代次质控记录","status":"信息","detail":"","trigger":null},{"label":"不良事件剂量关联","status":"信息","detail":"","trigger":null}],"stat":{"符合":0,"部分符合":0,"不符合":0,"不适用":0,"未知":0}},{"name":"维度五：动态知情同意","icon":"🔄","tram":"O","items":[{"label":"持续更新","status":"信息","detail":"","trigger":null},{"label":"咨询渠道","status":"信息","detail":"","trigger":null},{"label":"人员培训","status":"信息","detail":"","trigger":null},{"label":"退出管理","status":"信息","detail":"","trigger":null},{"label":"脆弱人群","status":"信息","detail":"","trigger":null},{"label":"伦理审查","status":"信息","detail":"","trigger":null},{"label":"退出权保障","status":"信息","detail":"","trigger":null},{"label":"研究变更时重新同意","status":"信息","detail":"","trigger":null},{"label":"撤回同意即时生效","status":"信息","detail":"","trigger":null},{"label":"不良反应实时告知","status":"信息","detail":"","trigger":null},{"label":"年度随访知情重申","status":"信息","detail":"","trigger":null},{"label":"儿童年龄过渡期重新知情","status":"信息","detail":"","trigger":null},{"label":"解冻后效期变更告知","status":"信息","detail":"","trigger":null},{"label":"传代接近上限提前告知","status":"信息","detail":"","trigger":null},{"label":"剂量组DLT实时告知","status":"信息","detail":"","trigger":null}],"stat":{"符合":0,"部分符合":0,"不符合":0,"不适用":0,"未知":0}}]}];

const STATUS_CLASS = {
  "符合":"ok", "部分符合":"part", "不符合":"no",
  "不适用":"na", "未知":"unk", "信息":"info"
};

let currentRec = null;
let serverOnline = false;

function esc(s){
  return String(s == null ? "" : s).replace(/[&<>"']/g, function(c){
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
  });
}

async function checkServer(){
  try{
    const r = await fetch("/api/health", {cache:"no-store"});
    serverOnline = r.ok;
  }catch(e){ serverOnline = false; }
}

document.querySelectorAll(".tab").forEach(function(tab){
  tab.addEventListener("click", function(){
    document.querySelectorAll(".tab").forEach(function(t){ t.classList.remove("active"); });
    document.querySelectorAll(".panel").forEach(function(p){ p.classList.remove("active"); });
    tab.classList.add("active");
    document.getElementById("panel-" + tab.dataset.tab).classList.add("active");
    if(tab.dataset.tab === "search") document.getElementById("q").focus();
  });
});

function switchTab(name){
  document.querySelectorAll(".tab").forEach(function(t){ t.classList.remove("active"); });
  document.querySelectorAll(".panel").forEach(function(p){ p.classList.remove("active"); });
  const tab = document.querySelector('.tab[data-tab="' + name + '"]');
  if(tab) tab.classList.add("active");
  const panel = document.getElementById("panel-" + name);
  if(panel) panel.classList.add("active");
}

function renderStudy(rec, target, showTRAM){
  let html = "";
  html += '<div class="study-card">';
  html += '  <div class="study-title">' + esc(rec.title) + '</div>';
  html += '  <div class="study-meta">';
  html += '    <span class="tag">' + esc(rec.nct || "无NCT编号") + '</span>';
  if(rec.dims && rec.dims[0] && rec.dims[0].items){
    const d1 = rec.dims[0].items;
    if(d1[0] && d1[0].detail) html += '<span class="tag g">' + esc(d1[0].detail.slice(0,28)) + '</span>';
    if(d1[1] && d1[1].detail) html += '<span class="tag o">' + esc(d1[1].detail.slice(0,28)) + '</span>';
  }
  html += '  </div>';
  if(showTRAM){
    html += '  <button class="btn tram" onclick="onTRAMClick()">📊 生成 TRAM 适配剖面</button>';
    html += '  <button class="btn orch" onclick="onCohortClick()">📈 运行队列回归</button>';
  }
  html += '</div>';

  rec.dims.forEach(function(d){
    const st = d.stat || {};
    const isTRAMDim = (d.tram === "R" || d.tram === "O" || d.tram === "G");
    html += '<div class="dim">';
    html += '  <div class="dim-head">';
    html += '    <span style="font-size:18px">' + esc(d.icon) + '</span>';
    html += '    <span class="t">' + esc(d.name) + '</span>';
    if(isTRAMDim) html += '<span class="chip tram">TRAM · ' + d.tram + '</span>';
    html += '    <span style="display:flex;gap:7px;flex-wrap:wrap">';
    if(st["符合"])     html += '<span class="chip ok">符合 ' + st["符合"] + '</span>';
    if(st["部分符合"]) html += '<span class="chip part">部分 ' + st["部分符合"] + '</span>';
    if(st["不符合"])   html += '<span class="chip no">不符合 ' + st["不符合"] + '</span>';
    if(st["不适用"])   html += '<span class="chip na">不适用 ' + st["不适用"] + '</span>';
    html += '    </span>';
    html += '  </div>';

    d.items.forEach(function(it){
      const cls = STATUS_CLASS[it.status] || "unk";
      html += '<div class="item">';
      html += '  <div class="row">';
      html += '    <span class="dot ' + cls + '"></span>';
      html += '    <span class="lbl">' + esc(it.label) + '</span>';
      if(it.trigger) html += '<span class="chip tram">触发 ' + esc(it.trigger) + '</span>';
      html += '    <span class="badge ' + cls + '">' + esc(it.status) + '</span>';
      html += '  </div>';
      if(it.detail) html += '  <div class="det">' + esc(it.detail) + '</div>';
      html += '</div>';
    });
    html += '</div>';
  });
  target.innerHTML = html;
  if(showTRAM) currentRec = rec;
}

function renderTRAM(r){
  const trigDefs = [
    {code:"C", name:"冻存"},{code:"E", name:"体外培养/传代"},
    {code:"A", name:"异体来源"},{code:"I", name:"免疫抑制"},
    {code:"D", name:"剂量递增/DLT"},{code:"L", name:"长期随访"}
  ];
  const scoreDefs = [
    {key:"R", name:"R · 风险透明度", cls:"r"},
    {key:"O", name:"O · 持续知情同意", cls:"o"},
    {key:"G", name:"G · 数据/样本治理", cls:"g"}
  ];
  const gapTitles = {
    R: "维度二：风险获益沟通",
    O: "维度五：动态知情同意",
    G: "维度四：数据与样本治理"
  };

  let html = "";
  html += '<div class="study-card">';
  html += '  <div class="study-title">' + esc(r.rec_title || "") + '</div>';
  html += '  <div class="study-meta">';
  html += '    <span class="tag">TCS = ' + r.tcs + ' / 6</span>';
  html += '    <span class="tag o">Mismatch = ' + r.mismatch.toFixed(1) + '</span>';
  html += '  </div>';
  html += '</div>';

  html += '<div class="tram-panel">';
  html += '  <h2>📊 TRAM 技术—风险适配诊断</h2>';
  html += '  <div class="tram-sub">Technology–Risk Adaptation Model · 由后端 Python 模型计算</div>';

  html += '  <div class="tram-section">';
  html += '    <h3><span class="num-badge">STEP 1</span>技术触发识别</h3>';
  html += '    <div class="triggers">';
  trigDefs.forEach(function(t){
    const on = r.triggers[t.code] === 1;
    html += '      <div class="trigger ' + (on ? "on" : "") + '" title="' + esc(r.trigger_note[t.code] || "") + '">';
    html += '        <div class="tcode">' + t.code + '</div>';
    html += '        <div class="tname">' + t.name + '</div>';
    html += '        <div class="tstate">' + (on ? "触发" : "未触发") + '</div>';
    html += '      </div>';
  });
  html += '    </div>';
  html += '    <div class="tcs-display">';
  html += '      <span class="tcs-label">TCS =</span>';
  html += '      <span class="tcs-num">' + r.tcs + '</span>';
  html += '      <span class="tcs-max">/ 6</span>';
  html += '    </div>';
  html += '  </div>';

  html += '  <div class="tram-section">';
  html += '    <h3><span class="num-badge">STEP 2</span>三维保护得分 S(d)</h3>';
  html += '    <div class="score-bars">';
  scoreDefs.forEach(function(sd){
    const v = r.scores[sd.key];
    const disp = v === null ? "不适用" : v.toFixed(1);
    const pct = v === null ? 0 : Math.max(0, Math.min(100, v));
    html += '      <div class="score-row">';
    html += '        <div class="score-head"><span>' + sd.name + '</span>';
    html += '          <span class="val">' + disp + (v === null ? "" : " / 100") + '</span></div>';
    html += '        <div class="score-bar"><div class="score-fill ' + (v === null ? "na" : sd.cls) + '" style="width:' + pct + '%"></div></div>';
    html += '      </div>';
  });
  html += '    </div>';
  html += '  </div>';

  html += '  <div class="tram-section">';
  html += '    <h3><span class="num-badge">STEP 3</span>适配剖面 — 与队列参考方向对照</h3>';
  html += '    <table class="profile-table">';
  html += '      <thead><tr><th>保护领域</th><th>队列 α 系数</th><th>方向</th><th>本篇得分</th></tr></thead>';
  html += '      <tbody>';
  ["R","O","G"].forEach(function(k){
    const q = r.queue_alpha[k];
    const v = r.scores[k];
    const nameMap = {R:"风险透明度", O:"持续知情同意", G:"数据/样本治理"};
    html += '        <tr>';
    html += '          <td>' + nameMap[k] + '</td>';
    html += '          <td>' + (q.value > 0 ? "+" : "") + q.value.toFixed(2) + '</td>';
    html += '          <td><span class="dir ' + (q.value > 0 ? "pos" : "warn") + '">' + q.label + '</span></td>';
    html += '          <td><b>' + (v === null ? "—" : v.toFixed(1)) + '</b></td>';
    html += '        </tr>';
  });
  html += '      </tbody>';
  html += '    </table>';
  html += '  </div>';

  html += '  <div class="tram-section">';
  html += '    <h3><span class="num-badge">STEP 4</span>覆盖率与不匹配</h3>';
  html += '    <div class="mismatch-grid">';
  html += '      <div class="mm-box"><div class="mm-label">Overall Coverage</div>';
  html += '        <div class="mm-val">' + r.overall_coverage.toFixed(1) + '</div></div>';
  html += '      <div class="mm-box mismatch"><div class="mm-label">Mismatch</div>';
  html += '        <div class="mm-val">' + r.mismatch.toFixed(1) + '</div></div>';
  html += '    </div>';
  html += '  </div>';

  html += '  <div class="tram-section">';
  html += '    <h3><span class="num-badge">STEP 5</span>缺口定位 — 可修改的 ICF 条目清单</h3>';
  ["R","O","G"].forEach(function(k){
    const gaps = r.gaps[k] || [];
    html += '    <div class="gap-group">';
    html += '      <div class="gap-head">' +
            '<span>' + gapTitles[k] + '</span>' +
            (gaps.length > 0
              ? '<span class="tag-mini">' + gaps.length + ' 项待补</span>'
              : '<span class="tag-mini ok">全部达标</span>') +
            '</div>';
    html += '      <ul class="gap-list">';
    if(gaps.length === 0){
      html += '        <li class="empty">该维度所有适用条目均判定为「符合」，无缺口。</li>';
    } else {
      gaps.forEach(function(g){
        const cls = g.status === "部分符合" ? "partial" : "";
        html += '        <li class="' + cls + '"><b>' + esc(g.label) + '</b>（' + esc(g.status) + '）</li>';
      });
    }
    html += '      </ul>';
    html += '    </div>';
  });
  html += '  </div>';

  html += '  <div class="disclaimer">';
  html += '    ⚠️ <strong>使用边界：</strong>α_d 为队列层参数，本页面仅用于方向对照，';
  html += '    <strong>不构成对单项研究的合格/不合格判定</strong>。';
  html += '    TRAM 基于横断面公开 ICF 数据，支持关联和结构性模式，<strong>不支持因果推断</strong>。';
  html += '  </div>';

  html += '</div>';

  document.getElementById("tramContent").innerHTML = html;
  switchTab("tram");
  window.scrollTo({top:0, behavior:"smooth"});
}

function renderCohort(data){
  let html = "";
  html += '<div class="cohort-panel">';
  html += '  <h2 style="font-size:18px;color:#0f172a;margin-bottom:6px">📈 TRAM 队列层回归</h2>';
  html += '  <div style="font-size:12px;color:#94a3b8;margin-bottom:16px">';
  html += '    Huber M 稳健回归 · mode=' + esc(data.mode) + ' · N=' + data.n_rows;
  html += '  </div>';

  if(!data.results || !data.results.length){
    html += '<div class="status-msg err">未获得回归结果</div>';
  } else {
    html += '<table class="cohort-table"><thead><tr>';
    html += '<th>结局</th><th>队列 α (TCS)</th><th>SE</th><th>95% CI</th><th>p 值</th><th>ρ</th><th>n</th>';
    html += '</tr></thead><tbody>';
    data.results.forEach(function(r){
      if(r["错误"]){
        html += '<tr><td>' + esc(r["结局"]) + '</td><td colspan="6" style="color:#b91c1c">' + esc(r["错误"]) + '</td></tr>';
      } else {
        html += '<tr>';
        html += '<td><b>' + esc(r["结局"]) + '</b></td>';
        html += '<td><b>' + (r["队列_alpha_TCS"]>0?"+":"") + r["队列_alpha_TCS"] + '</b></td>';
        html += '<td>' + r["SE"] + '</td>';
        html += '<td>[' + r["95%CI_low"] + ', ' + r["95%CI_high"] + ']</td>';
        html += '<td>' + r["p值"] + '</td>';
        html += '<td>' + r["Spearman_rho"] + '</td>';
        html += '<td>' + r["n"] + '</td>';
        html += '</tr>';
      }
    });
    html += '</tbody></table>';
  }

  html += '<div class="cohort-ref">';
  html += '  <b>📌 论文参考系数（TRAM 文档第 6 节）</b><br>';
  html += '  Risk Transparency: αR ≈ <b>+5.53</b>（正向）<br>';
  html += '  Ongoing Consent: αO ≈ <b>−2.45</b>（无明确正向）<br>';
  html += '  Governance: αG ≈ <b>−0.82</b>（无明确正向）<br>';
  html += '  Mismatch: αM ≈ <b>−5.93</b>（负向）';
  html += '</div>';

  html += '</div>';

  document.getElementById("tramContent").innerHTML = html;
  switchTab("tram");
  window.scrollTo({top:0, behavior:"smooth"});
}

async function onTRAMClick(){
  if(!currentRec){ alert("请先选择一份 ICF"); return; }
  if(!serverOnline){
    document.getElementById("tramContent").innerHTML =
      '<div class="status-msg err">⚠️ 后端服务未连接。请确认已运行 启动.bat，并通过 http://localhost:8000 访问本页面。</div>';
    switchTab("tram");
    return;
  }
  document.getElementById("tramContent").innerHTML = '<div class="status-msg info">⏳ 正在调用后端 Python 模型计算…</div>';
  switchTab("tram");
  try{
    const resp = await fetch("/api/tram/single", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify(currentRec)
    });
    if(!resp.ok) throw new Error("HTTP " + resp.status);
    const r = await resp.json();
    r.rec_title = currentRec.title;
    r.rec_nct = currentRec.nct;
    renderTRAM(r);
  }catch(e){
    document.getElementById("tramContent").innerHTML =
      '<div class="status-msg err">调用失败：' + esc(e.message) + '<br>请确认后端服务正在运行。</div>';
  }
}

async function onCohortClick(){
  if(!serverOnline){
    document.getElementById("tramContent").innerHTML =
      '<div class="status-msg err">⚠️ 后端服务未连接。请通过 http://localhost:8000 访问本页面。</div>';
    switchTab("tram");
    return;
  }
  document.getElementById("tramContent").innerHTML = '<div class="status-msg info">⏳ 正在运行队列回归…（首次可能较慢）</div>';
  switchTab("tram");
  try{
    const resp = await fetch("/api/tram/cohort", {method:"POST"});
    if(!resp.ok){
      const err = await resp.json().catch(function(){return {};});
      throw new Error(err.detail || ("HTTP " + resp.status));
    }
    const data = await resp.json();
    renderCohort(data);
  }catch(e){
    document.getElementById("tramContent").innerHTML =
      '<div class="status-msg err">队列回归失败：' + esc(e.message) + '</div>';
  }
}

const els = {
  q: document.getElementById("q"),
  sugg: document.getElementById("suggest"),
  result: document.getElementById("result"),
  hint: document.getElementById("hint"),
  total: document.getElementById("total")
};
els.total.textContent = DATA.length;

function doSearch(){
  const q = els.q.value.trim().toLowerCase();
  if(!q){
    els.sugg.innerHTML = "";
    els.result.innerHTML = "";
    els.hint.style.display = "block";
    return;
  }
  els.hint.style.display = "none";
  const hits = [];
  DATA.forEach(function(r, i){
    if((r.title||"").toLowerCase().indexOf(q) >= 0 || (r.nct||"").toLowerCase().indexOf(q) >= 0){
      hits.push(i);
    }
  });
  if(hits.length === 0){
    els.sugg.innerHTML = '<div class="sug" style="color:#94a3b8">未找到匹配的研究</div>';
    els.result.innerHTML = "";
    return;
  }
  if(hits.length === 1){
    els.sugg.innerHTML = "";
    renderStudy(DATA[hits[0]], els.result, true);
    return;
  }
  els.sugg.innerHTML = hits.slice(0, 30).map(function(i){
    return '<div class="sug" data-i="' + i + '"><b>' + esc(DATA[i].nct || "—") +
           '</b> &nbsp;' + esc(DATA[i].title) + '</div>';
  }).join("");
  els.result.innerHTML = "";
}

els.sugg.addEventListener("click", function(e){
  const el = e.target.closest(".sug");
  if(!el || !el.dataset.i) return;
  els.sugg.innerHTML = "";
  renderStudy(DATA[+el.dataset.i], els.result, true);
  els.result.scrollIntoView({behavior:"smooth", block:"start"});
});

let timer = null;
els.q.addEventListener("input", function(){
  clearTimeout(timer);
  timer = setTimeout(doSearch, 120);
});
els.q.addEventListener("keydown", function(e){
  if(e.key === "Enter"){
    const first = els.sugg.querySelector(".sug[data-i]");
    if(first) first.click(); else doSearch();
  }
});

const anaBtn = document.getElementById("analyzeBtn");
const clrBtn = document.getElementById("clearBtn");
const ta = document.getElementById("newICF");
const anaRes = document.getElementById("analyzeResult");
const anaMeta = document.getElementById("analyzeMeta");

anaBtn.addEventListener("click", function(){
  const text = ta.value.trim();
  if(!text){ anaMeta.textContent = "⚠️ 请先粘贴文本"; return; }
  anaMeta.textContent = "正在分析…";
  const totalChar = text.length;
  const dims = [];

  dims.push({
    name: "维度一：技术披露", icon: "🔬", tram: null,
    items: [
      {label: "干细胞类型", status: /间充质|MSC|造血干细胞|HSCT|iPSC|脂肪干细胞|ADSC|角膜缘/.test(text) ? "符合" : "不符合", detail: ""},
      {label: "细胞来源（自体/异体）", status: /自体|异体|allogeneic|autologous/.test(text) ? "符合" : "不符合", detail: "", trigger: "A"},
      {label: "处理方式（培养/基因编辑/分化）", status: /培养|基因编辑|分化|转染/.test(text) ? "符合" : "不符合", detail: ""},
